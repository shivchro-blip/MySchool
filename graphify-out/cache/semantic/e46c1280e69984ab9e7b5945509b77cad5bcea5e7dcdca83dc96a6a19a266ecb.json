{"nodes": [{"id": "phase1_database_schema", "label": "Phase 1: Database Schema", "file_type": "document", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "db_layer", "label": "Database Access Layer (backend/db/)", "file_type": "code", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All Supabase queries are centralized in backend/db/ so modules never directly access the database, enabling clean separation of business logic from persistence concerns."}, {"id": "db_table_subjects", "label": "DB Table: subjects", "file_type": "document", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "db_table_chapters", "label": "DB Table: chapters", "file_type": "document", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "db_table_topics", "label": "DB Table: topics", "file_type": "document", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "db_table_content_chunks", "label": "DB Table: content_chunks", "file_type": "document", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw PDF text is never stored in the database; only structured JSON chunks are stored. This is an explicit hard rule to keep the DB lean and to force proper content structuring before storage."}, {"id": "db_table_questions", "label": "DB Table: questions", "file_type": "document", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "capt