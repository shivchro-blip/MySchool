idation before they are served to students. This prevents AI-extracted errors from reaching production without review."}, {"id": "concept_free_paid_plans", "label": "Free vs Paid User Plans", "file_type": "document", "source_file": "phase1-database-schema.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "phase1_database_schema", "target": "phase2_content_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase1-database-schema.md", "source_location": "Completion summary: Next: Phase 2", "weight": 1.0}, {"source": "db_layer", "target": "tech_supabase", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase1-database-schema.md", "source_location": "backend/db/client.py: create_client", "weight": 1.0}, {"source": "db_table_subjects", "target": "db_table_chapters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase1-database-schema.md", "source_location": "chapters.subject_id references subjects(id)", "weight": 1.0}, {"source": "db_table_chapters", "target": "db_table_topics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase1-database-schema.md", "source_location": "topics.chapter_id references chapters(id)", "weight": 1.0}, {"source": "db_table_topics", "target": "db_table_content_chunks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase1-database-schema.md", "source_location": "content_chunks.topic_id references topics(id)", "weight": 1.0}, {"source": "db_table_chapters", "target": "db_table_content_chunks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase1-database-schema.md", "source_location": "content_chunks.chapter_id references chapters(id)", "weight": 1.0}, {"source": "db_table_chapters", "