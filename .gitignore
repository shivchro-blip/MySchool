# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Environment — never commit env files (only .env.example is tracked)
.env
.env.local
.env.*.local

# Keys / certificates / signing material — never commit
*.pem
*.jks
*.keystore
*.p12
yadhum-twa/
migration*.patch

# Content (never commit PDFs or vector store)
content/raw/
content/embeddings/

# Node
node_modules/
dist/
.next/

# Flutter
.dart_tool/
app/build/
*.g.dart

# OS
.DS_Store
Thumbs.db

# Logs
*.log

.claude/
.idea/

source/textbooks/*.pdf
tmp/

# Graphify analysis output (never commit)
graphify-out/

# Local git worktrees (superpowers subagent-driven-development scratch)
.worktrees/

# Local dev artifacts (never commit)
Dummy_files/
.launch/
.graphify_python
frontend/web/test-results/
