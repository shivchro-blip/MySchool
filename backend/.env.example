# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Access tokens are verified locally (no Supabase round trip per request).
# ES256/RS256 signing keys: nothing to set — public keys come from JWKS.
# Legacy HS256 projects: Dashboard → Settings → API → JWT Secret, or every
# request falls back to a Supabase Auth round trip.
SUPABASE_JWT_SECRET=
AUTH_LOCAL_JWT=true
AUTH_REMOTE_CACHE_SECONDS=60

# Observability
LOG_LEVEL=INFO
SLOW_REQUEST_MS=1000
CORS_MAX_AGE_SECONDS=7200

# Ollama (local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# OpenRouter (fallback AI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku

# App
# Local development must set APP_ENV=development explicitly.
# Production must not rely on defaults; if APP_ENV is unset, the app now fails safe as production.
APP_ENV=development
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173

# Cache
REDIS_URL=
CACHE_TTL_SECONDS=604800
