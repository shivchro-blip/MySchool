# Copy to .env.local for development. Only PUBLIC values belong here —
# the Supabase publishable (anon) key is safe for clients; never put the
# service key or JWT secret in any frontend env file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_API_BASE_URL=http://localhost:8000/api
